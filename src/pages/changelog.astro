---
import Base from "../layouts/Base.astro";
import { nextUpdateDue } from "../lib/data";

interface Entry {
  frontmatter: { date: string; window: string };
  Content: any;
  file: string;
}

// One Markdown file per quarterly sweep (content/changelog/YYYY-MM.md); README.md is guidance, not an entry.
const modules = import.meta.glob<Entry>("/content/changelog/*.md", { eager: true });
const entries = Object.entries(modules)
  .filter(([path]) => !path.endsWith("/README.md"))
  .map(([, m]) => m)
  .sort((a, b) => String(b.frontmatter.date).localeCompare(String(a.frontmatter.date)));
const nextDueLabel = nextUpdateDue().toLocaleDateString("en-IN", { year: "numeric", month: "long" });
---

<Base title="Changelog">
  <h1>Changelog</h1>
  <p>
    This site is re-checked every quarter, in January, April, July and October (after the Karnataka
    budget, agency reports and Assembly sessions). Each sweep re-verifies every project and records here
    what changed and what could not be verified. Corrections between sweeps go in the
    {" "}<a href="/corrections">corrections log</a>, and individual developments appear under
    {" "}<a href="/changes">what changed</a>.
  </p>
  <p><strong>Next sweep due: {nextDueLabel}.</strong></p>

  {
    entries.length === 0 ? (
      <div class="card empty">
        <p>No quarterly sweep has been published yet. The first is due {nextDueLabel}.</p>
      </div>
    ) : (
      entries.map(({ frontmatter, Content }) => (
        <article class="card entry">
          <h2>{frontmatter.window}</h2>
          <p class="entry-date">Published {frontmatter.date}</p>
          <Content />
        </article>
      ))
    )
  }
</Base>

<style>
  .entry, .empty { padding: 1rem 1.25rem; margin-top: 1rem; }
  .entry h2 { margin-top: 0; }
  .entry-date { font-size: 0.82rem; color: var(--ink-muted); margin-top: -0.25rem; }
</style>
