---
import Base from "../layouts/Base.astro";
import { getChanges, agencyLabel, EVENT_TYPE_LABEL } from "../lib/data";

const changes = getChanges();
const years = [...new Set(changes.map((c) => c.event.date.slice(0, 4)))];
const uniqueSorted = (values: string[]) => [...new Set(values)].sort();
const agencies = uniqueSorted(changes.map((c) => c.project.agency));
const categories = uniqueSorted(changes.map((c) => c.project.category));
const types = uniqueSorted(changes.map((c) => c.event.type));
const label = (s: string) => s.replace(/_/g, " ");
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
---

<Base title="What changed">
  <h1>What changed</h1>
  <p>
    Every dated development we have on record, newest first: sanctions, tenders, awards, cost and
    deadline revisions, openings. Each one links to its source. Subscribe with{" "}
    <a href="/changes.xml">RSS</a> or use the <a href="/changes.json">JSON feed</a>.
  </p>

  {
    changes.length === 0 ? (
      <p>No events recorded yet.</p>
    ) : (
      <>
        <div class="filter-bar" role="search" aria-label="Filter changes">
          <label>
            <span>Agency</span>
            <select id="c-agency">
              <option value="">All</option>
              {agencies.map((a) => <option value={a}>{a}</option>)}
            </select>
          </label>
          <label>
            <span>Category</span>
            <select id="c-category">
              <option value="">All</option>
              {categories.map((c) => <option value={c}>{label(c)}</option>)}
            </select>
          </label>
          <label>
            <span>Type</span>
            <select id="c-type">
              <option value="">All</option>
              {types.map((t) => <option value={t}>{EVENT_TYPE_LABEL[t]}</option>)}
            </select>
          </label>
        </div>
        <p id="c-count" class="filter-count" aria-live="polite">Showing all {changes.length} changes.</p>

        {years.map((year) => (
          <section class="year" data-year={year}>
            <h2>{year}</h2>
            <ol class="change-list">
              {changes
                .filter((c) => c.event.date.startsWith(year))
                .map(({ event, project, source }) => (
                  <li
                    class="card change"
                    data-agency={project.agency}
                    data-category={project.category}
                    data-type={event.type}
                  >
                    <div class="change-meta">
                      <time datetime={event.date}>{formatDate(event.date)}</time>
                      <span class="event-type">{EVENT_TYPE_LABEL[event.type]}</span>
                    </div>
                    <a class="change-project" href={`/projects/${project.id}`}>{project.name}</a>
                    <span class="change-agency">{agencyLabel(project)}</span>
                    <p class="change-summary">
                      {event.summary}
                      {event.new_deadline && (
                        <span class="change-deadline">
                          Deadline: {event.previous_deadline ? `${event.previous_deadline} → ` : ""}{event.new_deadline}
                        </span>
                      )}
                    </p>
                    {source && (
                      <p class="change-source">
                        Source: <a href={source.url} target="_blank" rel="noopener">{source.publisher}</a>
                        {source.archive_url && <> (<a href={source.archive_url} target="_blank" rel="noopener">archived</a>)</>}
                        {" "}· {label(source.doc_type)}
                      </p>
                    )}
                  </li>
                ))}
            </ol>
          </section>
        ))}
        <p id="c-empty" class="filter-empty" hidden>No changes match these filters.</p>
      </>
    )
  }
</Base>

<style>
  .year h2 { margin: 2rem 0 0.75rem; }
  .change-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .change { padding: 0.9rem 1.1rem; }
  .change-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--ink-muted); }
  .change-meta time { font-weight: 600; }
  .event-type {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
  }
  .change-project { display: inline-block; margin-top: 0.4rem; font-weight: 600; text-decoration: none; }
  .change-project:hover { text-decoration: underline; }
  .change-agency { margin-left: 0.4rem; font-size: 0.78rem; color: var(--ink-muted); }
  .change-summary { margin: 0.35rem 0 0; }
  .change-deadline { display: block; font-size: 0.85rem; font-weight: 600; margin-top: 0.2rem; }
  .change-source { margin: 0.35rem 0 0; font-size: 0.78rem; color: var(--ink-muted); }
</style>

<script>
  const selects = ["c-agency", "c-category", "c-type"].map((id) => document.getElementById(id) as HTMLSelectElement | null);
  const items = Array.from(document.querySelectorAll<HTMLLIElement>("li.change"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("section.year"));
  const countEl = document.getElementById("c-count");
  const emptyEl = document.getElementById("c-empty");
  const [agencyEl, categoryEl, typeEl] = selects;

  function apply() {
    let visible = 0;
    for (const li of items) {
      const show =
        (!agencyEl?.value || li.dataset.agency === agencyEl.value) &&
        (!categoryEl?.value || li.dataset.category === categoryEl.value) &&
        (!typeEl?.value || li.dataset.type === typeEl.value);
      li.hidden = !show;
      if (show) visible++;
    }
    for (const s of sections) s.hidden = !s.querySelector("li.change:not([hidden])");
    if (countEl) {
      countEl.hidden = visible === 0;
      countEl.textContent =
        visible === items.length ? `Showing all ${items.length} changes.` : `Showing ${visible} of ${items.length} changes.`;
    }
    if (emptyEl) emptyEl.hidden = visible !== 0;
  }
  for (const el of selects) el?.addEventListener("input", apply);
</script>
