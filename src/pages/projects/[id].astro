---
import Base from "../../layouts/Base.astro";
import { label } from "../../i18n";
import StageTracker from "../../components/StageTracker.astro";
import {
  getProjects,
  getSource,
  getCorrections,
  getProjectGeometries,
  isStale,
  agencyLabel,
  projectFacts,
  projectTimeline,
  isWholeProject,
  CONFIDENCE_MEANING,
  formatCr,
  formatPct,
  stageIndex,
  STAGE_ORDER,
} from "../../lib/data";

export function getStaticPaths() {
  return getProjects().map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const facts = projectFacts(project);
const timeline = projectTimeline(project.id);
const corrections = getCorrections().filter((c) => c.project_id === project.id);
const stale = isStale(project);
const onMap = getProjectGeometries().some((g) => g.projectId === project.id);

// Number sources in the order the timeline first cites them.
const sourceIds = [...new Set(timeline.map((t) => (t.kind === "event" ? t.event.source_id : t.entry.source_id)))];
const sources = sourceIds.map((id, i) => ({ n: i + 1, source: getSource(id)! })).filter((s) => s.source);
const ref = (id: string) => sources.find((s) => s.source.id === id)?.n;

const related = getProjects()
  .filter((p) => p.id !== project.id && p.agency === project.agency)
  .slice(0, 5);

const date = (d: string) =>
  new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const monthYear = (d: string) => new Date(d).toLocaleDateString("en-IN", { month: "short", year: "numeric", timeZone: "UTC" });
const deadlineShown = project.current_deadline ?? project.original_deadline;
const stage = stageIndex(project.status);
---

<Base title={project.name}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/projects">Projects</a> <span aria-hidden="true">/</span> {label("category", project.category)}</nav>

  <header class="p-head">
    <span class={`status-tab status-${project.status}`}>
      {label("status", project.status)}{stage !== null && ` · stage ${stage + 1} of ${STAGE_ORDER.length}`}
    </span>
    <h1>{project.name}</h1>
    <p class="p-sub">
      {agencyLabel(project)} · {project.scope}
      {project.aka && project.aka.length > 0 && <span class="aka"> Also called {project.aka.join(", ")}.</span>}
    </p>
    <StageTracker status={project.status} />
  </header>

  <dl class="key-facts">
    {
      facts.cost && (
        <div>
          <dt>Latest cost</dt>
          <dd>{formatCr(facts.cost.amount_cr)}</dd>
          <p>{label("kind", facts.cost.kind)}, {monthYear(facts.cost.as_of)}</p>
        </div>
      )
    }
    {
      facts.change !== null && (
        <div>
          <dt>Change since sanction</dt>
          <dd>{formatPct(facts.change)}</dd>
          <p>from {formatCr(facts.sanctioned!.amount_cr)}</p>
        </div>
      )
    }
    {
      deadlineShown && (
        <div>
          <dt>{project.status === "complete" ? "Deadline was" : "Current deadline"}</dt>
          <dd>{monthYear(deadlineShown)}</dd>
          <p>{facts.slippage !== null && facts.slippage > 0 ? `${facts.slippage} months later than first promised` : project.original_deadline && project.current_deadline ? "as first promised" : "original deadline not on record"}</p>
        </div>
      )
    }
    <div>
      <dt>Last checked</dt>
      <dd class={stale ? "stale" : ""}>{date(project.verified_on)}</dd>
      <p>{stale ? "possibly outdated" : "re-checked every quarter"}</p>
    </div>
  </dl>

  {
    facts.missing.length > 0 && (
      <p class="missing">
        <strong>Not on record yet:</strong> {facts.missing.join(", ")}. Missing data is shown, not guessed.
      </p>
    )
  }

  {
    project.pending && (
      <section class="card pending">
        <h2>What's pending</h2>
        <p>{project.pending}</p>
      </section>
    )
  }

  <section>
    <h2>History</h2>
    {
      timeline.length === 0 ? (
        <p>No dated figures or developments recorded yet.</p>
      ) : (
        <ol class="timeline">
          {timeline.map((item) =>
            item.kind === "event" ? (
              <li class="t-event">
                <time datetime={item.date}>{date(item.date)}</time>
                <div>
                  <span class="t-tag">{label("event_type", item.event.type)}</span>
                  <p>
                    {item.event.summary}{" "}
                    <a class="ref" href={`#source-${ref(item.event.source_id)}`}>[{ref(item.event.source_id)}]</a>
                  </p>
                  {item.event.new_deadline && (
                    <p class="t-deadline">
                      Deadline: {item.event.previous_deadline ? `${monthYear(item.event.previous_deadline)} → ` : ""}
                      {monthYear(item.event.new_deadline)}
                    </p>
                  )}
                </div>
              </li>
            ) : (
              <li class={`t-money ${isWholeProject(item.entry) ? "" : "t-part"}`}>
                <time datetime={item.date}>{date(item.date)}</time>
                <div>
                  <span class="t-tag t-tag-money">{label("kind", item.entry.kind)}</span>
                  <p>
                    <strong class="amount">{formatCr(item.entry.amount_cr)}</strong>
                    {item.entry.covers ? <span class="part"> Part figure: {item.entry.covers}</span> : <span class="whole"> whole project</span>}
                    {item.entry.comparable_to_prior === false && !item.entry.covers && <span class="part"> Not comparable with earlier figures.</span>}{" "}
                    <a class="ref" href={`#source-${ref(item.entry.source_id)}`}>[{ref(item.entry.source_id)}]</a>
                  </p>
                  <p class="t-detail">Funder: {label("funder", item.entry.funder)} · FY {item.entry.fiscal_year}</p>
                  {item.entry.funder_detail && (
                    <details class="ctx">
                      <summary>Context</summary>
                      <p>{item.entry.funder_detail}</p>
                    </details>
                  )}
                </div>
              </li>
            )
          )}
        </ol>
      )
    }
    <p class="t-note">
      Sanctioned, released and spent are different things: an allocation is not evidence money was spent.
      {facts.parts > 0 && " Part figures cover one contract, loan or package and are never used as the project's cost."}
    </p>
  </section>

  {
    corrections.length > 0 && (
      <section class="card corrections">
        <h2>Corrections to this page</h2>
        <ul>
          {corrections.map((c) => (
            <li><strong>{date(c.date)}:</strong> {c.now} <span class="was">Previously: {c.was}</span></li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="sources">
    <h2>Sources</h2>
    <p class="confidence-line">
      <span class={`confidence confidence-${project.confidence}`}>{label("confidence", project.confidence)} confidence</span>{" "}
      This page is {CONFIDENCE_MEANING[project.confidence]}.
    </p>
    {
      sources.length === 0 ? (
        <p>No sources recorded yet.</p>
      ) : (
        <ol class="source-list">
          {sources.map(({ n, source }) => (
            <li id={`source-${n}`}>
              <a href={source.url} target="_blank" rel="noopener">{source.title}</a>
              {source.archive_url && <> · <a href={source.archive_url} target="_blank" rel="noopener">archived copy</a></>}
              <span class="source-meta">{source.publisher} · {label("doc_type", source.doc_type)}{source.page_ref && ` · ${source.page_ref}`}</span>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  {
    project.notes && (
      <details class="notes">
        <summary>Notes and caveats</summary>
        <p>{project.notes}</p>
      </details>
    )
  }

  <p class="actions">
    {onMap && <a class="btn" href={`/map?project=${project.id}`}>See on map</a>}
    <a class="btn" href="/updates#report">Report an error</a>
  </p>

  {
    related.length > 0 && (
      <section class="related">
        <h2>More from {agencyLabel(project)}</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`/projects/${r.id}`}>{r.name}</a> <span class={`status-tab status-${r.status}`}>{label("status", r.status)}</span></li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .crumbs { font-size: 0.85rem; color: var(--ink-muted); margin: 0.25rem 0 1rem; }
  .crumbs a { font-weight: 600; }
  .p-head h1 { margin: 0.6rem 0 0.4rem; }
  .p-sub { color: var(--ink-muted); margin: 0 0 0.5rem; }
  .aka { font-size: 0.9rem; }

  .key-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin: 1.5rem 0 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }
  .key-facts > div { padding: 0.9rem 1rem 0.9rem 0; }
  .key-facts > div + div { border-left: 1px solid var(--rule); padding-left: 1rem; }
  .key-facts dt { font-size: 0.8rem; color: var(--ink-muted); }
  .key-facts dd { margin: 0.1rem 0; font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .key-facts dd.stale { color: var(--status-stalled); }
  .key-facts p { margin: 0; font-size: 0.8rem; color: var(--ink-muted); }
  @media (max-width: 30rem) {
    .key-facts { grid-template-columns: 1fr 1fr; }
    .key-facts > div:nth-child(odd) { border-left: none; padding-left: 0; }
    .key-facts > div:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }

  .missing { font-size: 0.88rem; color: var(--ink-muted); margin-top: 0.9rem; max-width: none; }
  .pending { margin-top: 1.5rem; border-left: 4px solid var(--status-progress); }
  .pending h2 { margin-top: 0; font-size: 1.15rem; }
  .pending p { margin-bottom: 0; }

  .timeline { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--rule-strong); }
  .timeline li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.7rem 0 0.7rem 1rem; position: relative; }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -0.4rem;
    top: 1.05rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink-muted);
  }
  .timeline li.t-money::before { background: var(--ink); border-color: var(--ink); }
  .timeline li.t-part::before { background: var(--paper); border-style: dashed; }
  .timeline time { font-size: 0.85rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; padding-top: 0.1rem; }
  .timeline p { margin: 0.2rem 0 0; }
  .t-tag { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-muted); }
  .t-tag-money { color: var(--ink); }
  .amount { font-family: var(--font-display); font-size: 1.15rem; }
  .whole { font-size: 0.85rem; color: var(--ink-muted); }
  .part { font-size: 0.85rem; color: var(--status-progress); font-weight: 600; }
  .t-detail, .t-deadline { font-size: 0.85rem; color: var(--ink-muted); }
  .t-deadline { font-weight: 600; color: var(--ink); }
  .ref { font-size: 0.8rem; text-decoration: none; }
  .ctx { font-size: 0.85rem; color: var(--ink-muted); margin-top: 0.2rem; }
  .ctx summary { cursor: pointer; width: fit-content; }
  .ctx p { margin: 0.25rem 0 0; }
  .t-note { font-size: 0.82rem; color: var(--ink-muted); margin-top: 0.75rem; }
  @media (max-width: 40rem) {
    .timeline li { grid-template-columns: 1fr; gap: 0; }
  }

  .corrections { margin-top: 2rem; }
  .corrections h2 { margin-top: 0; font-size: 1.15rem; }
  .corrections ul { margin: 0; padding-left: 1.1rem; }
  .was { display: block; font-size: 0.85rem; color: var(--ink-muted); }

  .confidence-line { font-size: 0.9rem; }
  .source-list { padding-left: 1.4rem; margin: 0; }
  .source-list li { margin-bottom: 0.6rem; }
  .source-list li:target { background: var(--status-progress-bg); }
  .source-meta { display: block; font-size: 0.8rem; color: var(--ink-muted); }

  .notes { margin-top: 1.5rem; background: var(--card-bg); border-radius: var(--radius); padding: 0.9rem 1.2rem; box-shadow: var(--card-shadow); }
  .notes summary { cursor: pointer; font-weight: 600; }
  .notes p { margin-bottom: 0; font-size: 0.92rem; }

  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  .actions .btn { text-decoration: none; }
  .related ul { list-style: none; padding: 0; margin: 0; }
  .related li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
  .related a { font-weight: 600; text-decoration: none; }
  .related a:hover { text-decoration: underline; }
</style>
