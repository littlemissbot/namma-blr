---
import Base from "../layouts/Base.astro";
import { label } from "../i18n";
import {
  getProjects,
  getChanges,
  getSources,
  latestCost,
  originalSanctionedCost,
  standoutFacts,
  cityTotals,
  typicalConfidence,
  sourceStrength,
  CONFIDENCE_MEANING,
  formatCr,
  formatPct,
} from "../lib/data";

const projects = getProjects();
const totals = cityTotals();
const rise = totals.latest - totals.sanctioned;
const risePct = totals.sanctioned > 0 ? (rise / totals.sanctioned) * 100 : null;
const latestTotal = projects.reduce((sum, p) => sum + (latestCost(p.id)?.amount_cr ?? 0), 0);
const { biggestRise, longestDelay } = standoutFacts();
const noCost = projects.filter((p) => !latestCost(p.id)).length;

const categories = [...new Set(projects.map((p) => p.category))]
  .map((c) => ({ c, n: projects.filter((p) => p.category === c).length }))
  .sort((a, b) => b.n - a.n);
const updates = getChanges().slice(0, 5);

const sources = getSources();
const primarySources = sources.filter((s) => sourceStrength(s.doc_type) === "primary").length;
const typical = typicalConfidence();
const allTypical = projects.every((p) => p.confidence === typical);

const shortDate = (d: string) =>
  new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const monthYear = (d: string) => new Date(d).toLocaleDateString("en-IN", { month: "short", year: "numeric", timeZone: "UTC" });
const clip = (s: string, n = 140) => (s.length > n ? s.slice(0, s.lastIndexOf(" ", n)) + "…" : s);
---

<Base title="Home">
  <section class="hero">
    <h1>What Bengaluru was actually promised</h1>
    <p class="lede">
      What Karnataka's agencies have committed to build in Bengaluru, what it costs, how late it is, and what is
      still pending. Every figure carries its source and date.
    </p>
  </section>

  <section aria-labelledby="overview-h" class="overview">
    <h2 id="overview-h" class="visually-hidden">City overview</h2>
    <dl class="overview-strip">
      <div>
        <dt>Projects tracked</dt>
        <dd>{totals.projects}</dd>
        <p>across metro, roads, buses, water, lakes and parks</p>
      </div>
      <div>
        <dt>Latest cost on record</dt>
        <dd>{formatCr(Math.round(latestTotal))}</dd>
        <p>for the {totals.withCost} projects that have a whole-project figure</p>
      </div>
      {
        risePct !== null && (
          <div>
            <dt>Rise since sanction</dt>
            <dd>{formatPct(risePct)}</dd>
            <p>
              {formatCr(Math.round(rise))} more across the {totals.withBoth} projects with both a sanctioned and a later
              figure
            </p>
          </div>
        )
      }
    </dl>
  </section>

  <section aria-labelledby="standout-h">
    <h2 id="standout-h">Stand-out facts</h2>
    <div class="facts">
      {
        biggestRise && (
          <a class="card fact" href={`/projects/${biggestRise.project.id}`}>
            <span class="fact-label">Largest cost rise</span>
            <span class="fact-value">{formatPct(biggestRise.pct)}</span>
            <span class="fact-project">{biggestRise.project.name}</span>
            <span class="fact-detail">
              {formatCr(originalSanctionedCost(biggestRise.project.id)!.amount_cr)} sanctioned →{" "}
              {formatCr(latestCost(biggestRise.project.id)!.amount_cr)} latest
            </span>
          </a>
        )
      }
      {
        longestDelay && (
          <a class="card fact" href={`/projects/${longestDelay.project.id}`}>
            <span class="fact-label">Longest delay on record</span>
            <span class="fact-value">{longestDelay.months} months</span>
            <span class="fact-project">{longestDelay.project.name}</span>
            <span class="fact-detail">
              Deadline {monthYear(longestDelay.project.original_deadline!)} → {monthYear(longestDelay.project.current_deadline!)}
            </span>
          </a>
        )
      }
      {
        noCost > 0 && (
          <a class="card fact" href="/about#data-quality">
            <span class="fact-label">Still unknown</span>
            <span class="fact-value">{noCost} of {projects.length}</span>
            <span class="fact-project">projects have no whole-project cost on record</span>
            <span class="fact-detail">Missing figures are shown, not guessed. See what we have and what we're looking for.</span>
          </a>
        )
      }
    </div>
  </section>

  <section aria-labelledby="find-h" class="find card">
    <h2 id="find-h">Find a project</h2>
    <form action="/projects" method="get" class="search" role="search">
      <label for="home-q" class="visually-hidden">Search projects</label>
      <input id="home-q" name="q" type="search" placeholder="Metro line, road, lake, agency…" autocomplete="off" />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    <div class="find-row">
      <a class="btn" href="/map?locate=1">📍 What's in my ward?</a>
      <div class="chips" aria-label="Browse by category">
        {categories.map(({ c, n }) => (
          <a class="chip" href={`/projects?category=${c}`}>{label("category", c)} <span>{n}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="updates-h">
    <div class="section-head">
      <h2 id="updates-h">Latest updates</h2>
      <a class="pill-link" href="/updates">All updates →</a>
    </div>
    <ol class="update-list">
      {updates.map(({ event, project }) => (
        <li>
          <time datetime={event.date}>{shortDate(event.date)}</time>
          <div>
            <a href={`/projects/${project.id}`}>{project.name}</a>
            <span class="update-type">{label("event_type", event.type)}</span>
            <p>{clip(event.summary)}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <p class="data-note">
    {
      allTypical
        ? `Every project is currently ${label("confidence", typical)} confidence: ${CONFIDENCE_MEANING[typical]}.`
        : `Confidence varies by project; each project page says what its figures rest on.`
    }{" "}
    {primarySources} of {sources.length} sources are official documents.{" "}
    <a href="/about#data-quality">How we source the data</a>
  </p>
</Base>

<style>
  .hero { margin-top: 0.5rem; }
  .lede { color: var(--ink-muted); font-size: 1.1rem; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .overview-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0;
    margin: 1.5rem 0 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }
  .overview-strip > div { padding: 1rem 1.25rem 1rem 0; }
  .overview-strip > div + div { border-left: 1px solid var(--rule); padding-left: 1.25rem; }
  .overview-strip dt { font-size: 0.82rem; color: var(--ink-muted); }
  .overview-strip dd {
    margin: 0.15rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.5rem);
    font-variant-numeric: tabular-nums;
  }
  .overview-strip p { margin: 0; font-size: 0.82rem; color: var(--ink-muted); }
  @media (max-width: 40rem) {
    .overview-strip > div + div { border-left: none; border-top: 1px solid var(--rule); padding-left: 0; }
  }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
  .fact { display: flex; flex-direction: column; gap: 0.2rem; text-decoration: none; color: var(--ink); }
  .fact:hover { outline: 1.5px solid var(--rule-strong); }
  .fact-label { font-size: 0.78rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
  .fact-value { font-family: var(--font-display); font-weight: 700; font-size: 2rem; line-height: 1.1; }
  .fact-value-small { font-size: 1.35rem; }
  .fact-project { font-weight: 600; }
  .fact-detail { font-size: 0.85rem; color: var(--ink-muted); }

  .find { margin-top: 2.5rem; }
  .find h2 { margin-top: 0; }
  .search { display: flex; gap: 0.5rem; max-width: 40rem; }
  .search input { flex: 1; min-width: 0; font-size: 1rem; padding: 0.7rem 0.9rem; }
  .find-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
    background: var(--paper-raised);
  }
  .chip:hover { border-color: var(--ink-muted); }
  .chip span { color: var(--ink-muted); margin-left: 0.2rem; }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .update-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .update-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--rule); }
  .update-list time { font-size: 0.85rem; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .update-list a { font-weight: 600; text-decoration: none; }
  .update-list a:hover { text-decoration: underline; }
  .update-list p { margin: 0.2rem 0 0; font-size: 0.92rem; }
  .update-type { margin-left: 0.5rem; font-size: 0.75rem; color: var(--ink-muted); border: 1px solid var(--rule-strong); border-radius: var(--radius-pill); padding: 0.1rem 0.5rem; }
  @media (max-width: 40rem) {
    .update-list li { grid-template-columns: 1fr; gap: 0.1rem; }
  }

  .data-note { margin-top: 2rem; font-size: 0.88rem; color: var(--ink-muted); max-width: none; }
</style>
